# ----------------------
# Terraform / OpenTofu
# ----------------------
.terraform/
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info
crash.log
crash.*.log

# Sensitive / variable files
*.tfvars
*.tfvars.json

# Local overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI config
.terraformrc
terraform.rc

# Plans (optional)
# *tfplan*

# ----------------------
# Ansible
# ----------------------
# SSH keys / private materials
ansible/ssh/*
!ansible/ssh/.gitkeep

# Generated inventories + backups
ansible/inventory/*.yaml
ansible/inventory/*.yaml.bak

# Retry files
*.retry

# ----------------------
# Inventory host definitions (environment-specific)
# ----------------------
infrastructure/**/inventory-hosts.yaml

# ----------------------
# Python / Scripts
# ----------------------
__pycache__/
*.pyc
*.pyo
*.pyd
*.pytest_cache/

# Virtual envs
.venv/
env/
venv/
ENV/

# ----------------------
# General / Misc
# ----------------------
# Large binaries / ISOs
*.iso
*.zip

# Generic "output" folders/files
*output*

# Editor / IDE
.vscode/
.idea/
*.swp

# Vault / secrets (keep out of repo)
.vault-password*
vault-pass*
*.vaultpass

